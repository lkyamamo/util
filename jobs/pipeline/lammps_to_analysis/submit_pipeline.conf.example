# submit_pipeline.conf.example — template for submit_pipeline.conf.
#
# submit_pipeline.sh refuses to run unless submit_pipeline.conf exists next
# to it (same directory). Copy this file to submit_pipeline.conf and edit
# the values below for your setup:
#
#   cp submit_pipeline.conf.example submit_pipeline.conf
#
# submit_pipeline.conf is gitignored — it holds your own local paths and
# should not be committed. This file (the .example) is the tracked template.
#
# Every value here is just a default: any of submit_pipeline.sh's flags
# (--input-script, --rdf-r-max, --nodes, ...) overrides the corresponding
# variable below for that one invocation. Run submit_pipeline.sh --help for
# what each variable/flag controls.
#
# This file is sourced as bash, so $REPO_ROOT (set by submit_pipeline.sh
# before sourcing this file) and normal bash quoting rules are available.

# general input parameters
INPUT_SCRIPT="/scratch1/lkyamamo/test-runs/potential-verify/runs/0168/OH-therm.input"
STARTING_STRUCTURE="/home1/lkyamamo/util/starting-structures/ICE_CUBIC.data"
POTENTIAL_FILE="/scratch1/lkyamamo/test-runs/potential-verify/potentials/20260723_OH.vashishta"
POTENTIAL_LINK_NAME="OH.usc"
ANALYSIS_PARENT_DIR="/scratch1/lkyamamo/test-runs/potential-verify/analysis"
ANALYSIS_TEMPLATE_DIR="$REPO_ROOT/analysis/distributions/20260608_GrNrBaSqw"
RUN_DSF="0"
RUN_RDF="1"
RUN_BAD="1"
RUN_VDOS="0"
RUN_MSD="0"
RUN_VDOS_DYNMAT="0"

# LAMMPS executable. Empty = the default in jobs/slurm/lammps_submit.slurm,
# which is .../lmp_mpi_phonon_2019 — the phonon build, since dynamical_matrix
# needs the PHONON package. Point this at .../lmp_mpi_shock_2019 to go back to
# the previous binary.
LMP_BIN=""

# trajectory creation slurm parameters
NODES="1"
NTASKS="128"
TIME="1:00:00"
JOB_NAME="water-setup"
CONSTRAINT="epyc-9554"
NODELIST=""

# analysis slurm parameters
ANALYSIS_NODES="1"
ANALYSIS_NTASKS="1"
ANALYSIS_TIME="1:00:00"
ANALYSIS_JOB_NAME="water-distributions"
ANALYSIS_CONSTRAINT="epyc-9554"
ANALYSIS_CPUS_PER_TASK=""
ANALYSIS_NODELIST=""

# distribution code parameters
RDF_R_MAX="8"
RDF_BINS_VAL="800"
BAD_ELEMENTS="O;H"
BAD_R_CUTOFF=""
BAD_R_MINCUT=""
BAD_TRIPLET_CUTOFFS="H-O-H:H-O-H:1.2:0.5:1.2:0.5|H--O--H:H-O-H:2.4:1.49:2.4:1.49|O-H--O:O-H-O:1.2:0.5:2.4:1.49"
BAD_BINS_VAL="360"
DSF_DT=""
DSF_N_FRAMES=""
DSF_STRIDE=""
DSF_WINDOW_SIZE=""
DSF_Q_MAX=""
DSF_N_Q_BINS=""
# DYNAMICS_DT is the only parameter vdos.py and msd.py share (the dt of
# dynamics.lammpstrj, a property of the trajectory rather than of either
# analysis); everything else below is per script and set independently —
# VDOS needs a short correlation length for frequency resolution, MSD a long
# one to reach the diffusive regime.
#
# Keys marked REQUIRED have no default: leaving one empty aborts the run up
# front (before the LAMMPS stage) rather than silently substituting a number.
# The values below are examples for a 2 fs / 50 ps water trajectory.
DYNAMICS_DT="2.0"                    # REQUIRED when RUN_VDOS=1 or RUN_MSD=1
VDOS_N_FRAMES=""
VDOS_STRIDE=""
VDOS_CORR_LENGTH="2000"              # REQUIRED when RUN_VDOS=1 — sets frequency resolution (dnu ~ 1/L)
VDOS_CORR_INTERVAL="100"             # REQUIRED when RUN_VDOS=1 — sets noise level only
VDOS_MAX_FREQUENCY_EV="0.5"          # REQUIRED when RUN_VDOS=1 — 0.5 eV = 4033 cm^-1
VDOS_NUM_GRIDS=""
VDOS_METHOD=""
VDOS_WINDOW=""
VDOS_NORMALIZATION=""
MSD_N_FRAMES=""
MSD_STRIDE=""
MSD_CORR_LENGTH="5000"               # REQUIRED when RUN_MSD=1 — max time lag
MSD_CORR_INTERVAL="500"              # REQUIRED when RUN_MSD=1 — spacing between origins
MSD_FIT_FRACTION="0.4"               # REQUIRED when RUN_MSD=1 — tail fraction for the D fit

# dynamical-matrix VDOS parameters (RUN_VDOS_DYNMAT=1)
#
# This is the one setting that spans both stages: it appends a minimization +
# dynamical_matrix block to the end of in.input, acting on the configuration the
# MD run finished with, and then diagonalizes the result in vdos_dynmat.py. The
# DYNMAT_* keys drive LAMMPS (they reach in.input as -var); the VDOS_DYNMAT_*
# keys drive the .py. Leave any empty to keep the default written into the
# .input file / the script's CONFIGURATION block.
#
# Cost before you enable it: 6N force evaluations and a (3N)^2 matrix. At
# replicate 6 6 6 (N=5184) that is 31104 force evaluations and a 15552x15552
# matrix — ~1.9 GB in memory, ~2.9 GB as text. Budget TIME for the trajectory
# job accordingly, and consider DYNMAT_BINARY="yes".
DYNMAT_MIN_STYLE=""                  # min_style, default cg
DYNMAT_MIN_ETOL=""                   # default 1.0e-12
DYNMAT_MIN_FTOL=""                   # default 1.0e-12 — the one that matters; residual
                                     # forces become spurious imaginary modes
DYNMAT_MIN_MAXITER=""                # default 100000
DYNMAT_MIN_MAXEVAL=""                # default 1000000
DYNMAT_DISPLACEMENT=""               # finite-difference step in Angstrom, default 0.0001
DYNMAT_FILE=""                       # matrix filename, default dynmat.dat. One value
                                     # reaches both stages, so the writer and the reader
                                     # cannot disagree
DYNMAT_BINARY=""                     # yes = raw float64, no (default) = text
VDOS_DYNMAT_MAX_FREQUENCY="500"      # REQUIRED when RUN_VDOS_DYNMAT=1 — DOS grid upper
                                     # limit, in VDOS_DYNMAT_XUNIT. 500 meV = 4033 cm^-1
VDOS_DYNMAT_XUNIT=""                 # meV (default) | THz | cm-1 | eV. The CSV always
                                     # carries all four; this sets the plot axis and the
                                     # unit MAX_FREQUENCY/SMEARING are read in
VDOS_DYNMAT_BINS=""                  # frequency grid points, default 500
VDOS_DYNMAT_SMEARING=""              # Gaussian FWHM in XUNIT; 0 (default) = histogram
VDOS_DYNMAT_MATRIX_STYLE=""          # regular (default) | eskm — must match the
                                     # dynamical_matrix style in the .input file
VDOS_DYNMAT_NORMALIZATION=""         # phonon (default; integral = 3 per atom) | unit_area
VDOS_DYNMAT_PARTIAL=""               # yes (default) | no — 'no' skips the per-element
                                     # curves and halves memory and runtime
VDOS_DYNMAT_ASR=""                   # none (default) | simple — acoustic sum rule
VDOS_DYNMAT_OUTPUT=""                # output basename, default vdos_dynmat
