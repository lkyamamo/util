## Ar  FCC lattice
echo            both
units           metal
dimension       3
boundary        p p p
processors      * * *
atom_style      atomic

read_data       start.data
replicate       6 6 6

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

mass 1 15.9994  # O
mass 2 1.00784  # H

pair_style      usc
pair_coeff  * * OH.usc O H

#pair_modify	coord 2 1 2.0 0.3
#pair_modify	coord 2 3 1.4 0.3

#cg relax
thermo_style    custom step temp pe ke etotal press vol
thermo          50
min_style       cg
minimize        1.0e-8 1.0e-8 5000 10000

reset_timestep  0

dump            1 all custom 100 water_setup.custom id element x y z vx vy vz
dump_modify	1 element O H
dump_modify	1 sort id

velocity        all create 10.0 156467 mom yes rot yes dist gaussian
timestep        0.00025


################ 10K deform prep ##################
fix		def all deform 10 x final 0.0 37.2514 y final 0.0 37.2514 z final 0 37.2514
fix		1 all nvt temp 10 10 $(100*dt)
run		100000
unfix		def
unfix		1
############### end deform prep ###############

############### max temp 400K ################
fix		1 all nvt temp 10 400 $(100*dt)
run		20000
unfix		1

fix             1 all nvt temp 400 400 $(100*dt)
run             100000
unfix           1
############### end temp 400K #################

############### temp 303K ################
fix		1 all nvt temp 400 303 $(100*dt)
run		20000
unfix		1

fix             1 all nvt temp 303 303 $(100*dt)
run             100000
unfix           1
############### end temp 303K #################


undump		1

variable        thermo_frequency equal 50
variable        dump_frequency equal 50
variable        nve_length equal 50000

reset_timestep  0
dump            mydump all custom ${dump_frequency} dump.lammpstrj id element x y z vx vy vz
dump_modify     mydump element O H
dump_modify     mydump sort id

fix             1 all nve temp
run             ${nve_length}
unfix           1
undump          mydump

write_restart   final.restart
write_data      final.data


