## Ar  FCC lattice
echo            both
units           metal
dimension       3
boundary        p p p
processors      * * *
atom_style      atomic

# ---- dynamical-matrix VDOS (vdos_dynmat.py) ------------------------------
# Off by default: this file's normal job is the MD trajectory below. Setting
# RUN_DYNMAT=1 appends a minimization + dynamical_matrix block at the very end,
# acting on the final MD configuration. "variable ... index" is the LAMMPS form
# whose value a command-line -var overrides, so submit_pipeline.sh drives all of
# these; the values here are what applies when it doesn't.
#
# Cost, before you turn this on: the finite-difference loop costs 6N force
# evaluations and produces a (3N)^2 matrix. With replicate 6 6 6 on
# ICE_CUBIC.data that is N=5184 -> 31104 force evaluations and a 15552x15552
# matrix (~1.9 GB in memory, ~2.9 GB as text). Set DYNMAT_BINARY=yes to write
# raw float64 instead of text.
variable        RUN_DYNMAT          index 0
variable        DYNMAT_MIN_STYLE    index cg
variable        DYNMAT_MIN_ETOL     index 1.0e-12
variable        DYNMAT_MIN_FTOL     index 1.0e-12
variable        DYNMAT_MIN_MAXITER  index 100000
variable        DYNMAT_MIN_MAXEVAL  index 1000000
variable        DYNMAT_DISPLACEMENT index 0.0001
variable        DYNMAT_FILE         index dynmat.dat
variable        DYNMAT_BINARY       index no

# dynamical_matrix needs an atom map, and atom_modify must come before
# read_data. Conditional so an MD-only run (RUN_DYNMAT=0) is unchanged.
if "${RUN_DYNMAT} == 1" then "atom_modify map array"
# --------------------------------------------------------------------------

read_data       start.data
replicate       6 6 6

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

mass 1 15.9994  # O
mass 2 1.00784  # H

pair_style      usc
pair_coeff  * * OH.usc O H

#pair_modify	coord 2 1 2.0 0.3
#pair_modify	coord 2 3 1.4 0.3

#cg relax
thermo_style    custom step temp pe ke etotal press vol
thermo          50
min_style       cg
minimize        1.0e-8 1.0e-8 5000 10000

reset_timestep  0

dump            1 all custom 100 water_setup.custom id element x y z vx vy vz
dump_modify	1 element O H
dump_modify	1 sort id

velocity        all create 10.0 156467 mom yes rot yes dist gaussian
timestep        0.00025


################ 10K deform prep ##################
fix		def all deform 10 x final 0.0 37.2514 y final 0.0 37.2514 z final 0 37.2514
fix		1 all nvt temp 10 10 $(100*dt)
run		100000
unfix		def
unfix		1
############### end deform prep ###############

############### max temp 400K ################
fix		1 all nvt temp 10 400 $(100*dt)
run		20000
unfix		1

fix             1 all nvt temp 400 400 $(100*dt)
run             100000
unfix           1
############### end temp 400K #################

############### temp 303K ################
fix		1 all nvt temp 400 303 $(100*dt)
run		20000
unfix		1

fix             1 all nvt temp 303 303 $(100*dt)
run             100000
unfix           1
############### end temp 303K #################


undump		1

variable        thermo_frequency equal 50
variable        dump_frequency equal 50
variable        dynamics_dump_frequency equal 10
variable        nve_length equal 50000

reset_timestep  0
dump            mydump all custom ${dump_frequency} dump.lammpstrj id element x y z vx vy vz
dump_modify     mydump element O H
dump_modify     mydump sort id

# Separate, higher-frequency trajectory for dsf.py/vdos.py (dynamic structure
# factor / vibrational density of states) — resolving vibrational frequencies
# needs much finer time sampling than the structural dump above.
dump            mydyn all custom ${dynamics_dump_frequency} dynamics.lammpstrj id element x y z vx vy vz
dump_modify     mydyn element O H
dump_modify     mydyn sort id

fix             1 all nve temp
run             ${nve_length}
unfix           1
undump          mydump
undump          mydyn

write_restart   final.restart
write_data      final.data

############### dynamical-matrix VDOS (RUN_DYNMAT=1) ###############
# Runs on the configuration the MD above just finished with — all fixes
# released, all dumps closed — so the minimization drops it into the nearest
# inherent structure and dynamical_matrix builds the mass-weighted force
# constants there. The tolerances are much tighter than the pre-MD CG relax
# above on purpose: residual forces show up directly as spurious imaginary
# modes in the eigenvalue spectrum.
#
# The group must stay `all`. dynamical_matrix iterates atoms by global ID, so
# matrix row 3i+alpha is atom ID i+1 — which is what lets vdos_dynmat.py take
# the per-atom element from dump.lammpstrj (written with dump_modify sort id)
# without any extra output from this file.
if "${RUN_DYNMAT} == 0" then "jump SELF end_dynmat"

min_style       ${DYNMAT_MIN_STYLE}
minimize        ${DYNMAT_MIN_ETOL} ${DYNMAT_MIN_FTOL} ${DYNMAT_MIN_MAXITER} ${DYNMAT_MIN_MAXEVAL}
dynamical_matrix all regular ${DYNMAT_DISPLACEMENT} file ${DYNMAT_FILE} binary ${DYNMAT_BINARY}

label end_dynmat
####################################################################


