# =============================================================================
# nas.config — configuration for nas.sh
# =============================================================================

# === Connection ===
HPC_USER=lkyamamo
HPC_HOST=endeavour.usc.edu
REMOTE_BASE=/scratch1/lkyamamo/finalized-bubble-collapse
LOCAL_BASE=/Volumes/Elements/20260624-finalized-bubble-collapse

# === Transfer mode default ===
# direct : recursive rsync with no compression (the only supported mode)
# Archive mode (HPC-side SLURM compression) was removed; see ARCHIVE_MODE_NOTES.md.
DEFAULT_MODE=direct

# === Rsync transfer priority ===
# Transfers run in two global phases:
#   PHASE 1 — for every directory: RSYNC_PRIORITY_FIRST, then everything
#             except RSYNC_PRIORITY_LAST
#   PHASE 2 — for every directory: RSYNC_PRIORITY_LAST
# so all the small/important files land before any bulk trajectory data starts.
RSYNC_PRIORITY_FIRST=("in.*" "*.lammps" "log.*")
RSYNC_PRIORITY_LAST=("*.lammpstrj" "*.dump")

# === Never transfer ===
# Excluded from every pass, always, regardless of --skip-trajectory. Use this for
# data that is derived and disposable rather than data you might want later.
#
# dielectric.*.custom are the dielectric-production trajectories
# (dumps/dielectric.${i}.custom). They are reduced to dipole lines on the HPC and
# the sweep pipeline deletes them there once reduced, so there is no reason to
# pull them — and they are large enough to fill the drive on their own. Note they
# match neither *.lammpstrj nor *.dump, so without this entry they transfer in
# phase 1, before any deferred-file handling gets a say.
ALWAYS_EXCLUDE=("dielectric.*.custom")

# === Trajectory skipping ===
# When active, the RSYNC_PRIORITY_LAST globs above are not synced at all: phase 2
# is skipped entirely, and directories settle at MAIN_DONE rather than UPLOADED,
# so a later run without the flag picks them up and finishes them.
# Override per run with --skip-trajectory / --no-skip-trajectory.
SKIP_TRAJECTORY=false

# === Directories ===
# Format: "dirname" or "dirname:mode" where mode overrides DEFAULT_MODE
DIRECTORIES=(
    "analysis"
    "potentials"
    "runs"
    "structures"
)
