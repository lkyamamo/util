## Ar  FCC lattice
echo            both
units           metal
dimension       3
boundary        p p p
processors      * * *
atom_style      atomic

read_data	start.data

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

#mass 1 28.0855  # Si
mass 1 15.9994  # O
mass 2 1.00784	# H 

pair_style      usc
pair_coeff  * * OH.usc O H
#pair_modify coord 2 1 2.0 0.3
#pair_modify coord 2 3 1.4 0.3

variable	thermo_frequency equal 50
variable	dump_frequency equal 50
variable	nve_length equal 50000

reset_timestep  0
thermo_style    custom step temp pe ke etotal press vol
thermo          ${thermo_frequency}

dump            mydump all custom ${dump_frequency} dump.lammpstrj id element x y z vx vy vz
dump_modify     mydump element O H
dump_modify     mydump sort id

timestep        0.00025

############ start nvt ##########

fix             1 all nve temp
run             ${nve_length}
unfix           1

#######################################

undump		mydump
